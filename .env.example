# TipShield Environment Configuration
# Copy to .env and fill in real values

# Gemini API Key for Gemma model access
GEMINI_API_KEY= your_gemini_api_key_here

# Gemma model configuration
GEMMA_MODEL_ID=gemma-4-31b-it
GEMMA_MOCK=false
GEMMA_THINKING=false
GEMMA_MAX_CONCURRENT=4

# API authentication
API_KEY= 

# Internal service authentication
INTERNAL_API_KEY= 

# Report hashing
REPORT_HASH_PEPPER= 

# Telegram Bot (optional - bot idles without this)
TELEGRAM_BOT_TOKEN=

# Market service URL (internal)
MARKET_SERVICE_URL=http://market-service:8000

# Database
DATABASE_PATH=tipshield.db

# Logging
LOG_LEVEL=Information

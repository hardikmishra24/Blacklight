# Multi-stage build for TipShield.Bot (Telegram Worker Service)
FROM mcr.microsoft.com/dotnet/sdk:11.0-preview AS build
WORKDIR /src

# Copy project files and restore dependencies
COPY src/TipShield.Core/TipShield.Core.csproj src/TipShield.Core/
COPY src/TipShield.Bot/TipShield.Bot.csproj src/TipShield.Bot/
RUN dotnet restore src/TipShield.Bot/TipShield.Bot.csproj

# Copy source code and build
COPY src/TipShield.Core/ src/TipShield.Core/
COPY src/TipShield.Bot/ src/TipShield.Bot/
WORKDIR /src/src/TipShield.Bot
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/runtime:10.0-preview AS runtime
WORKDIR /app
USER $APP_UID

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "TipShield.Bot.dll"]

